// Numeric HUD layout check. The client must already be in a survival world.
// Food comes from vanilla's real sprite draw calls; thirst comes from ThirstHud.drawBar.
// The second half puts the player under water and compares the real vanilla air row with the thirst
// row from the same client frame, then drains the water again.
{"id":"settle","command":"wait","args":{"ticks":40}}
{"id":"visible","command":"client.state","expect":{"result.barShouldRender":true,"result.creative":false}}
{"id":"stack","command":"client.hud","expect":{"result.recording":true,"result.geometry.icons":10,"result.geometry.barWidth":81,"result.bar.width":81,"result.food.width":81},"checks":[{"left":"result.bar.right","op":"eq","right":"result.food.right"},{"left":"result.bar.bottom","op":"le","right":"result.food.top"},{"left":"result.bar.drawnMsAgo","op":"lt","value":1000},{"left":"result.food.drawnMsAgo","op":"lt","value":1000}]}
{"id":"submerge","command":"server.command","args":{"command":"execute at @p run fill ~ ~ ~ ~ ~1 ~ minecraft:water"}}
{"id":"underwaterSettle","command":"wait","args":{"ticks":40}}
{"id":"underwater","command":"client.hud","expect":{"result.recording":true,"result.geometry.barWidth":81},"checks":[{"left":"result.air.bottom","op":"le","right":"result.bar.top"},{"left":"result.air.right","op":"eq","right":"result.bar.right"},{"left":"result.air.drawnMsAgo","op":"lt","value":1000},{"left":"result.bar.drawnMsAgo","op":"lt","value":1000}]}
{"id":"drain","command":"server.command","args":{"command":"execute at @p run fill ~-3 ~-1 ~-3 ~3 ~2 ~3 minecraft:air replace minecraft:water"}}
