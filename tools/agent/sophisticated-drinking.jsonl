// The Drinking upgrade drinks from the backpack when the thirst bar is low, the cleanest water first,
// then other drinks, and nothing below its lowest grade. Only nodes that set deps.sophisticated_core
// have it on the runClient classpath.
//
// Six backpacks from tools/agent/sophisticated-pack. A water bottle, or a 250 mB serving from a tank,
// is 6 thirst and 8 quenched; the basic upgrade drinks once half a drink fits and only Clean water or
// better. Each case starts at thirst 4 unless it says otherwise.
// - drinking_pick, one dirty and two clean bottles: "pickDrunk" shows thirst 16. The export holds the
//   dirty bottle and two glass bottles.
// - drinking_tank, a Tank of 1000 mB of Pure water and one clean bottle: "tankDrunk" shows thirst 20,
//   the tank keeps 250 mB of water_purity 3, and the clean bottle is still there.
// - drinking_salt, a Tank of sea water and one murky bottle: nothing is drunk, "saltRefused" shows 4.
// - drinking_advanced, an Advanced upgrade set to Pure only and to drink when the whole drink fits,
//   with two clean bottles and one pure: "advancedDrunk" shows thirst 10, the two clean bottles left.
// - drinking_other, a honey bottle, Farmer's Delight apple cider (8), a milk bucket, an awkward potion
//   and an ominous bottle: "otherDrunk" shows 16, the honey and the cider gone, two glass bottles
//   back, and the milk, the awkward potion and the ominous bottle untouched.
// - drinking_order, a honey bottle before a clean bottle, from thirst 14: water goes first, so
//   "orderDrunk" shows 20 and the honey is still there. Honey first would stop at 18.
// Sophisticated only unpacks a template the first time the backpack is opened, so each is opened with
// the real right click and closed again.
//
// SophisticatedAgent is a throwaway world: copy level.dat out of any 1.21.1 world into
// run/1.21.1-neoforge/saves/SophisticatedAgent, and tools/agent/sophisticated-pack into its datapacks
// folder, fresh for each run. Then:
//     ./gradlew ":1.21.1-neoforge:runClient" -Pagent=tools/agent/sophisticated-drinking.jsonl -Pquickplay=SophisticatedAgent

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "reloadTemplates", "command": "server.command", "args": {"command": "reload"}}
{"id": "reloaded", "command": "wait", "args": {"ticks": 60}}
{"id": "joined", "command": "client.state"}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "difficulty", "command": "server.command", "args": {"command": "difficulty normal"}}
{"id": "lookUp", "command": "server.command", "args": {"command": "tp @p ~ ~ ~ 0 -90"}}

{"id": "drinking_pick_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "drinking_pick_effects", "command": "server.command", "args": {"command": "effect clear @p"}}
{"id": "drinking_pick_thirsty", "command": "server.thirst.set", "args": {"player": "Dev", "thirst": 4, "quenched": 0, "exhaustion": 0}}
{"id": "drinking_pick_give", "command": "server.command", "args": {"command": "sophisticatedbackpacks template give thirsttest:drinking_pick", "as": "Dev"}}
{"id": "drinking_pick_hand", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand from entity @p hotbar.0"}}
{"id": "drinking_pick_dedupe", "command": "server.command", "args": {"command": "execute unless data entity @p {SelectedItemSlot:0} run item replace entity @p hotbar.0 with minecraft:air"}}
{"id": "drinking_pick_open", "command": "client.hold", "args": {"keys": ["use"], "ticks": 5}}
{"id": "drinking_pick_opened", "command": "wait", "args": {"ticks": 10}}
{"id": "drinking_pick_close", "command": "client.screen", "args": {"open": "none"}}
{"id": "drinking_pick_drinking", "command": "wait", "args": {"ticks": 100}}
{"id": "pickDrunk", "command": "server.thirst.get", "args": {"player": "Dev"}}
{"id": "drinking_pick_create", "command": "server.command", "args": {"command": "sophisticatedbackpacks template create thirstout:drinking_pick true", "as": "Dev"}}
{"id": "drinking_pick_export", "command": "server.command", "args": {"command": "sophisticatedbackpacks template export thirstout:drinking_pick", "as": "Dev"}}

