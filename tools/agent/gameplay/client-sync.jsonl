// The sync checks MANUAL-TESTING.md lists, the four items one client can answer. The fifth needs a
// second client and is driven from the two queues separately; see src/dev/java/AGENTS.md.
//
// Run a dedicated server and one of its clients, then
//     python tools/agent/drive.py run/manual-<node>-A/agent/A tools/agent/gameplay/client-sync.jsonl
// The client has to be in the world already and standing somewhere flat, and the server needs
// fall_damage off, or walking for thirty ticks is a check of the terrain rather than of the mod.
//
// Expectations are checked by drive.py. A wrong value makes it exit 1 just like a refused request.

// Build a flat, obstacle-free lane so the sprint assertion measures the gate rather than terrain.
// The manual clients are operators; every command still travels through the real client connection.
{"id": "laneFloor", "command": "client.command", "args": {"command": "fill -8 99 -8 8 99 24 minecraft:stone"}}
{"id": "clearLane", "command": "client.command", "args": {"command": "fill -8 100 -8 8 104 24 minecraft:air"}}
{"id": "lane", "command": "client.command", "args": {"command": "tp @s 0 100 0"}}
{"id": "feed", "command": "client.command", "args": {"command": "effect give @s minecraft:saturation 1 10 true"}}
{"id": "laneReady", "command": "wait", "args": {"ticks": 20}}

// 1. /thirst set reaches the client, and the sprint gate opens at 7 and closes at 6.
//    state7.thirst == 7, hud7.bar.thirst == 7, sprint7.sprinting == true
{"id": "set7", "command": "client.command", "args": {"command": "thirst set @s 7 0"}}
{"id": "w1", "command": "wait", "args": {"ticks": 10}}
{"id": "state7", "command": "client.state", "expect": {"result.thirst": 7, "result.quenched": 0}}
{"id": "hud7", "command": "client.hud", "expect": {"result.bar.thirst": 7, "result.bar.quenched": 0}}
// 1.21.1 only starts sprint after forward was already down on an earlier tick. Staging these keys
// also makes the request exercise the same input order on every supported client.
{"id": "forward7", "command": "client.key", "args": {"key": "forward", "down": true}}
{"id": "warm7", "command": "wait", "args": {"ticks": 5}}
{"id": "pressSprint7", "command": "client.key", "args": {"key": "sprint", "down": true}}
{"id": "run7", "command": "wait", "args": {"ticks": 8}}
{"id": "sprint7", "command": "client.state", "expect": {"result.sprinting": true}}
{"id": "releaseSprint7", "command": "client.key", "args": {"key": "sprint", "down": false}}
{"id": "releaseForward7", "command": "client.key", "args": {"key": "forward", "down": false}}
{"id": "settle7", "command": "wait", "args": {"ticks": 5}}
//    state6.thirst == 6, hud6.bar.thirst == 6, sprint6.sprinting == false
{"id": "set6", "command": "client.command", "args": {"command": "thirst set @s 6 0"}}
{"id": "w2", "command": "wait", "args": {"ticks": 10}}
{"id": "state6", "command": "client.state", "expect": {"result.thirst": 6, "result.quenched": 0}}
{"id": "hud6", "command": "client.hud", "expect": {"result.bar.thirst": 6, "result.bar.quenched": 0}}
{"id": "forward6", "command": "client.key", "args": {"key": "forward", "down": true}}
{"id": "warm6", "command": "wait", "args": {"ticks": 5}}
{"id": "pressSprint6", "command": "client.key", "args": {"key": "sprint", "down": true}}
{"id": "run6", "command": "wait", "args": {"ticks": 8}}
{"id": "sprint6", "command": "client.state", "expect": {"result.sprinting": false}}
{"id": "releaseSprint6", "command": "client.key", "args": {"key": "sprint", "down": false}}
{"id": "releaseForward6", "command": "client.key", "args": {"key": "forward", "down": false}}

// 2. Die and respawn: the bar is full again. dead.alive == false, revived.thirst == 20
{"id": "low", "command": "client.command", "args": {"command": "thirst set @s 4 0"}}
{"id": "w3", "command": "wait", "args": {"ticks": 10}}
{"id": "kill", "command": "client.command", "args": {"command": "kill @s"}}
{"id": "w4", "command": "wait", "args": {"ticks": 20}}
{"id": "dead", "command": "client.state", "expect": {"result.alive": false}}
{"id": "respawn", "command": "client.respawn", "expect": {"result.alive": true}}
{"id": "w5", "command": "wait", "args": {"ticks": 40}}
{"id": "revived", "command": "client.state", "expect": {"result.alive": true, "result.thirst": 20}}
{"id": "revivedHud", "command": "client.hud", "expect": {"result.bar.thirst": 20}}

// 3. Through the Nether and back: the bar is right on both sides.
//    nether.thirst == 9 and nether.dimension is the_nether; back.thirst == 9 in the overworld
{"id": "set93", "command": "client.command", "args": {"command": "thirst set @s 9 3"}}
{"id": "guard", "command": "client.command", "args": {"command": "effect give @s minecraft:fire_resistance 600 4 true"}}
{"id": "guard2", "command": "client.command", "args": {"command": "effect give @s minecraft:resistance 600 4 true"}}
{"id": "w6", "command": "wait", "args": {"ticks": 10}}
{"id": "here", "command": "client.state"}
{"id": "toNether", "command": "client.command", "args": {"command": "execute in minecraft:the_nether run tp @s 20 70 20"}}
{"id": "w7", "command": "wait", "args": {"ticks": 60}}
{"id": "netherFloor", "command": "client.command", "args": {"command": "execute at @s run fill ~-3 ~-1 ~-3 ~3 ~-1 ~3 minecraft:stone"}}
{"id": "air", "command": "client.command", "args": {"command": "execute at @s run fill ~-3 ~ ~-3 ~3 ~2 ~3 minecraft:air"}}
{"id": "w8", "command": "wait", "args": {"ticks": 40}}
{"id": "nether", "command": "client.state", "expect": {"result.thirst": 9, "result.quenched": 3, "result.dimension": "minecraft:the_nether"}}
{"id": "netherHud", "command": "client.hud", "expect": {"result.bar.thirst": 9, "result.bar.quenched": 3}}
{"id": "toOverworld", "command": "client.command", "args": {"command": "execute in minecraft:overworld run tp @s 20 103 20"}}
{"id": "w9", "command": "wait", "args": {"ticks": 60}}
{"id": "back", "command": "client.state", "expect": {"result.thirst": 9, "result.quenched": 3, "result.dimension": "minecraft:overworld"}}
{"id": "backHud", "command": "client.hud", "expect": {"result.bar.thirst": 9, "result.bar.quenched": 3}}

// 4. Quit to the title screen and rejoin: the bar shows the value it had.
//    title.screen is TitleScreen; rejoined.thirst == 9 and rejoinedHud.bar.thirst == 9
{"id": "leave", "command": "client.disconnect"}
{"id": "w10", "command": "wait", "args": {"ticks": 100}}
{"id": "title", "command": "client.info", "expect": {"result.inWorld": false, "result.screen": "net.minecraft.client.gui.screens.TitleScreen"}}
{"id": "rejoin", "command": "client.connect", "args": {"address": "localhost:25565"}}
{"id": "w11", "command": "wait", "args": {"ticks": 240}}
{"id": "rejoined", "command": "client.state", "expect": {"result.thirst": 9, "result.quenched": 3, "result.dimension": "minecraft:overworld"}}
{"id": "rejoinedHud", "command": "client.hud", "expect": {"result.bar.thirst": 9, "result.bar.quenched": 3}}
{"id": "evidence", "command": "client.capture", "args": {"name": "sync-to-the-client"}}
