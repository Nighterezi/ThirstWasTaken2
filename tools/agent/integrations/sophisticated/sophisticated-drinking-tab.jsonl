// The Drinking upgrade's settings tab: its buttons clicked, and its title in every language.
// Only nodes that set deps.sophisticated_core have it on the runClient classpath.
//
// The backpack is made to open straight onto the tab by setting sophisticatedcore:open_tab_id on it.
// The Advanced tab's two buttons sit 100 and 118 GUI pixels right of the screen's centre and 22 above
// it, which does not change with the window's size. drinking_advanced starts at "whole drink" and Pure:
// - one left click on the first button: "whole drink" moves on to "any";
// - one left click on the second: Pure wraps round to Dirty, then two right clicks go back to Pure and
//   down to Clean.
// The export thirstout:drinking_buttons then holds drink_at "any" and drink_min_purity 2, and the
// captures before and after show both buttons change.
//
// Then, for every language the mod ships, "<lang>_widths" measures both tab titles with the game's
// font, and both tabs are captured, so a cropped title ends in "..." on the picture. The basic tab's
// title has 37 GUI pixels of room and the advanced one's 55. The client is set back to English last.
//
// SophisticatedAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py 1.21.1-neoforge SophisticatedAgent --datapack tools/agent/integrations/sophisticated/sophisticated-pack
// Then:
//     ./gradlew ":1.21.1-neoforge:runClient" -Pagent=tools/agent/integrations/sophisticated/sophisticated-drinking-tab.jsonl -Pquickplay=SophisticatedAgent

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "reloadTemplates", "command": "server.command", "args": {"command": "reload"}}
{"id": "reloaded", "command": "wait", "args": {"ticks": 60}}
{"id": "joined", "command": "client.state"}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "difficulty", "command": "server.command", "args": {"command": "difficulty normal"}}
{"id": "lookUp", "command": "server.command", "args": {"command": "tp @p ~ ~ ~ 0 -90"}}

{"id": "buttons_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "buttons_full", "command": "server.thirst.set", "args": {"player": "Dev", "thirst": 20, "quenched": 20, "exhaustion": 0}}
{"id": "buttons_give", "command": "server.command", "args": {"command": "sophisticatedbackpacks template give thirsttest:drinking_advanced", "as": "Dev"}}
{"id": "buttons_hand", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand from entity @p hotbar.0"}}
{"id": "buttons_dedupe", "command": "server.command", "args": {"command": "execute unless data entity @p {SelectedItemSlot:0} run item replace entity @p hotbar.0 with minecraft:air"}}
{"id": "buttons_open", "command": "client.hold", "args": {"keys": ["use"], "ticks": 8}}
{"id": "buttons_opened", "command": "wait", "args": {"ticks": 10}}
{"id": "buttons_close", "command": "client.screen", "args": {"open": "none"}}
{"id": "buttons_tab", "command": "server.command", "args": {"command": "item modify entity @p weapon.mainhand {\"function\":\"minecraft:set_components\",\"components\":{\"sophisticatedcore:open_tab_id\":0}}"}}
{"id": "buttons_reopen", "command": "client.hold", "args": {"keys": ["use"], "ticks": 8}}
{"id": "buttons_shown", "command": "wait", "args": {"ticks": 20}}
{"id": "buttons_before", "command": "client.capture", "args": {"name": "drinking_buttons_before"}}
{"id": "drinkAtClick", "command": "client.click", "args": {"x": 100, "y": -22}}
{"id": "purityUp", "command": "client.click", "args": {"x": 118, "y": -22}}
{"id": "purityDown1", "command": "client.click", "args": {"x": 118, "y": -22, "button": 1}}
{"id": "purityDown2", "command": "client.click", "args": {"x": 118, "y": -22, "button": 1}}
{"id": "buttons_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "buttons_after", "command": "client.capture", "args": {"name": "drinking_buttons_after"}}
{"id": "buttons_shut", "command": "client.screen", "args": {"open": "none"}}
{"id": "buttons_create", "command": "server.command", "args": {"command": "sophisticatedbackpacks template create thirstout:drinking_buttons true", "as": "Dev"}}
{"id": "buttons_export", "command": "server.command", "args": {"command": "sophisticatedbackpacks template export thirstout:drinking_buttons", "as": "Dev"}}

