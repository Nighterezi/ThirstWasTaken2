{"id": "tank_skin_export", "command": "server.command", "args": {"command": "sophisticatedbackpacks template export thirstout:tank_skin", "as": "Dev"}}

// A dirty terracotta water bowl poured in, and an empty bowl filled: a water bowl with water_purity 0 in
// slot 3, an empty bowl in slot 2, and an empty tank.
{"id": "tank_bowl_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "tank_bowl_give", "command": "server.command", "args": {"command": "sophisticatedbackpacks template give thirsttest:tank_bowl", "as": "Dev"}}
{"id": "tank_bowl_hand", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand from entity @p hotbar.0"}}
