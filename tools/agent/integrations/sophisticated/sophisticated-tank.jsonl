{"id": "plain_bucket_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "plain_bucket_give", "command": "server.command", "args": {"command": "sophisticatedbackpacks template give thirsttest:plain_bucket", "as": "Dev"}}
{"id": "plain_bucket_hand", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand from entity @p hotbar.0"}}
