{"id": "plain_bucket_opened", "command": "wait", "args": {"ticks": 10}}
{"id": "plain_bucket_close", "command": "client.screen", "args": {"open": "none"}}
{"id": "plain_bucket_tick", "command": "wait", "args": {"ticks": 200}}
{"id": "plain_bucket_held", "command": "server.command", "args": {"command": "execute if items entity @p weapon.mainhand sophisticatedbackpacks:backpack"}}
{"id": "plain_bucket_create", "command": "server.command", "args": {"command": "sophisticatedbackpacks template create thirstout:plain_bucket true", "as": "Dev"}}
{"id": "plain_bucket_export", "command": "server.command", "args": {"command": "sophisticatedbackpacks template export thirstout:plain_bucket", "as": "Dev"}}

// A full murky waterskin is poured into the tank and a second, empty waterskin filled from it: the second
