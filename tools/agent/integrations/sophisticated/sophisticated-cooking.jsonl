// Sophisticated Backpacks' Smoking and Smelting upgrades purify water inside a backpack, through the
// mod's smoking and smelting recipes. Only nodes that set deps.sophisticated_core have Sophisticated on
// the runClient classpath.
//
// Each backpack from tools/agent/integrations/sophisticated/sophisticated-pack holds one cooking upgrade with a purity-0 bottle in
// its input and a piece of coal as fuel. Sophisticated only unpacks a template the first time the
// backpack is opened, so each is opened with the real right click and closed again. The export under the
// world's datapacks/thirstout_backpack_templates has to show, in the upgrade's cooking_inventory, slot 2
// holding a bottle with water_purity 2 and water_salty false, and no bottle left in slot 0.
//
// SophisticatedAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py 1.21.1-neoforge SophisticatedAgent --datapack tools/agent/integrations/sophisticated/sophisticated-pack
// Then:
//     ./gradlew ":1.21.1-neoforge:runClient" -Pagent=tools/agent/integrations/sophisticated/sophisticated-cooking.jsonl -Pquickplay=SophisticatedAgent

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "reloadTemplates", "command": "server.command", "args": {"command": "reload"}}
{"id": "reloaded", "command": "wait", "args": {"ticks": 60}}
{"id": "joined", "command": "client.state"}
{"id": "effects", "command": "server.command", "args": {"command": "effect clear @p"}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "float", "command": "server.command", "args": {"command": "effect give @p minecraft:slow_falling 600 0 true"}}

{"id": "cook_smoking_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "cook_smoking_give", "command": "server.command", "args": {"command": "sophisticatedbackpacks template give thirsttest:cook_smoking", "as": "Dev"}}
{"id": "cook_smoking_hand", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand from entity @p hotbar.0"}}
{"id": "cook_smoking_dedupe", "command": "server.command", "args": {"command": "execute unless data entity @p {SelectedItemSlot:0} run item replace entity @p hotbar.0 with minecraft:air"}}
{"id": "cook_smoking_lookUp", "command": "server.command", "args": {"command": "tp @p -240.5 201 160.5 0 -90"}}
{"id": "cook_smoking_open", "command": "client.hold", "args": {"keys": ["use"], "ticks": 5}}
{"id": "cook_smoking_opened", "command": "wait", "args": {"ticks": 10}}
{"id": "cook_smoking_close", "command": "client.screen", "args": {"open": "none"}}
{"id": "cook_smoking_cooking", "command": "wait", "args": {"ticks": 300}}
{"id": "cook_smoking_create", "command": "server.command", "args": {"command": "sophisticatedbackpacks template create thirstout:cook_smoking true", "as": "Dev"}}
{"id": "cook_smoking_export", "command": "server.command", "args": {"command": "sophisticatedbackpacks template export thirstout:cook_smoking", "as": "Dev"}}

{"id": "cook_smelting_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "cook_smelting_give", "command": "server.command", "args": {"command": "sophisticatedbackpacks template give thirsttest:cook_smelting", "as": "Dev"}}
{"id": "cook_smelting_hand", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand from entity @p hotbar.0"}}
{"id": "cook_smelting_dedupe", "command": "server.command", "args": {"command": "execute unless data entity @p {SelectedItemSlot:0} run item replace entity @p hotbar.0 with minecraft:air"}}
{"id": "cook_smelting_lookUp", "command": "server.command", "args": {"command": "tp @p -240.5 201 160.5 0 -90"}}
{"id": "cook_smelting_open", "command": "client.hold", "args": {"keys": ["use"], "ticks": 5}}
{"id": "cook_smelting_opened", "command": "wait", "args": {"ticks": 10}}
{"id": "cook_smelting_close", "command": "client.screen", "args": {"open": "none"}}
{"id": "cook_smelting_cooking", "command": "wait", "args": {"ticks": 300}}
{"id": "cook_smelting_create", "command": "server.command", "args": {"command": "sophisticatedbackpacks template create thirstout:cook_smelting true", "as": "Dev"}}
{"id": "cook_smelting_export", "command": "server.command", "args": {"command": "sophisticatedbackpacks template export thirstout:cook_smelting", "as": "Dev"}}
