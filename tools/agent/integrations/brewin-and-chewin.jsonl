{"id": "kegBHolds", "command": "server.command", "args": {"command": "data get block 2 200 0 FluidTank"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "\"thirstwastaken2:water_purity\": 0"}]}

// A plain bucket still fills a keg with plain water, as before the integration. A glass bottle drawn
// from it comes out stamped defaultPurity with water_salty: false, so it can be cooked; the keg's own
// bottle carried neither. A plain water bottle still tops the keg back up, which the bottle recipe
// only allows while the bottle matches its own exactly.
{"id": "kegC", "command": "server.command", "args": {"command": "setblock 4 200 0 brewinandchewin:keg"}}
{"id": "clearC", "command": "server.command", "args": {"command": "clear @p"}}
