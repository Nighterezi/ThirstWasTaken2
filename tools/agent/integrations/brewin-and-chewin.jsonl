{"id": "glassB", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with minecraft:glass_bottle"}}
{"id": "drawB", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "drawnB", "command": "wait", "args": {"ticks": 10}}
{"id": "dirtyBottleB", "command": "server.command", "args": {"command": "execute if items entity @p container.* minecraft:potion[thirstwastaken2:water_purity=0,thirstwastaken2:water_salty=false]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
